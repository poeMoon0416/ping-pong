# 環境を変えたときにはこのファイルだけ変えるかたちにしたい

# hostsファイルの場所(Windows): "C:\Windows\System32\drivers\etc\hosts"
# 暫定予約済プライベート用途TLD(.internal): https://en.wikipedia.org/wiki/.internal, https://zenn.dev/at_yasu/articles/56654cce7bdcc824cd1e
# hostsファイルに追加: 127.0.0.1 ping-pong.internal
# VSCodeの設定に追加: Ctrl+Shift+P => Trusted Domains

PORT=1972
HOST="ping-pong.internal"
SRC_APP_ROOT="D:/vsc/ping-pong/src"
DIST_APP_ROOT="D:/vsc/ping-pong/dist"
